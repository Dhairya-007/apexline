# Unity logs. Unity writes its launch command line into these, one argument
# per line, including -accessToken and -hubSessionId. Read them with
# scripts/unity-log.sh, which redacts, never raw.
Editor.log
Editor-prev.log
upm.log
AssetImportWorker*.log
*.log

# Unity 6 generates .slnx (the new solution format) alongside the old .sln
*.slnx
.vscode/

# Player builds. A built player does not belong in the source repo;
# WebGL output is deployed to GitHub Pages from a separate branch.
/Build/

# Generated screenshots used for reviewing the look of the game
/Screenshots/
